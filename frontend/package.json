{
  "name": "lotlogic-frontend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "LotLogic operator dashboard and public pages. Built by esbuild, deployed by Vercel.",
  "scripts": {
    "build": "node scripts/build.mjs",
